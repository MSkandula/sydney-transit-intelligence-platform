# Copy this file to .env and fill in your own values. .env is git-ignored.

# TfNSW Open Data Hub — https://opendata.transport.nsw.gov.au/
TFNSW_API_KEY=

# Databricks Free Edition — from your workspace: Settings > Developer > Access tokens
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL Warehouse HTTP path — Databricks Free Edition's pre-provisioned
# "Serverless Starter Warehouse": SQL Warehouses > (the warehouse) > Connection details
DATABRICKS_HTTP_PATH=
